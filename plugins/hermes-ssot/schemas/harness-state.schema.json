{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-project.invalid/hermes/harness-state.schema.json",
  "title": "Hermes harness status snapshot",
  "type": "object",
  "required": ["schemaVersion", "version", "runId", "sessionId", "mode", "state", "terminal", "progress", "design", "implementation", "verification", "review", "finalization"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "version": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["delivery", "design"] },
    "state": { "enum": ["designing", "design-approved", "implementing", "verifying", "reviewing", "finalizing", "revision-required", "completed", "blocked", "failed", "cancelled"] },
    "terminal": { "type": "boolean" },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "design": { "type": "object" },
    "implementation": { "type": "object" },
    "verification": { "type": "object" },
    "review": { "type": "object" },
    "finalization": { "type": "object" }
  },
  "additionalProperties": true
}
